  "query": "\n            UPDATE \"game\"\n            SET game_status = $1,\n                questions_asked = questions_asked + 1,\n                updated_at = NOW()\n            WHERE id = $2\n            RETURNING id,\n                      game_type,\n                      game_status as \"game_status: Json<GameStatus>\",\n                      questions_asked,\n                      correct_answers,\n                      created_at,\n                      updated_at\n            ",
